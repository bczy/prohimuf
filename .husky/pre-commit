# Corepack fetches the pinned Yarn from repo.yarnpkg.com by default, which is
# blocked on some restricted networks (sandboxes/CI mirrors). Point it at the
# npm registry, which is reachable, so `yarn` works without that host.
export COREPACK_NPM_REGISTRY="${COREPACK_NPM_REGISTRY:-https://registry.npmjs.org}"

npx lint-staged
yarn lint
yarn format:check
