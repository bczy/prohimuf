.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# Environment
.env
.env.local

# Production build
dist/

# Test coverage
coverage/

# OS noise
.DS_Store
*.local

# Debug overlays from scripts/gen-window-zones.mjs --debug
scripts/.dbg-*.jpg
# Per-window crop evidence from the align-windows harness verification
scripts/.dbg-crops/

# CodeGraph local index (rebuilt per machine via `codegraph index`)
.codegraph/

# E2E smoke shots — regenerated each run, uploaded as CI artifacts
screenshots/e2e-home.png
screenshots/e2e-ingame.png
screenshots/e2e-ingame-*.png

# Local verification / Gate-4 evidence captures — never committed
screenshots/verify/

# Vehicle-halo preview shots — regenerated each run by scripts/preview-vehicle-halo.mjs
screenshots/preview-vehicle-*.png
screenshots/e2e-delivery.png

# ADR-0005 dynamic-verification harness — regenerated each run, uploaded as CI
# artifacts. screenshots/golden/ is NOT ignored — those baselines are committed.
screenshots/motion-belliard.png
screenshots/golden-candidate-*.png

# session-local screenshots / throwaway capture scripts (never commit)
scratchpad/
